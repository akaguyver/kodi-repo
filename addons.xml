<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.akaguyver" name="akaguyver's Kodi add-ons" version="1.0.0" provider-name="akaguyver">
  <extension point="xbmc.addon.repository" name="akaguyver's Kodi add-ons">
    <dir>
      <info compressed="false">https://akaguyver.github.io/kodi-repo/addons.xml</info>
      <checksum>https://akaguyver.github.io/kodi-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://akaguyver.github.io/kodi-repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Installs and auto-updates Kodi Sorter</summary>
    <description lang="en_GB">Repository for akaguyver's add-ons, served from GitHub Pages.</description>
    <platform>all</platform>
  </extension>
</addon>
<addon id="script.kodisorter" name="Kodi Sorter" version="1.13.0" provider-name="akaguyver">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Sort and rename downloads into Kodi TV/Movies/Comics folders</summary>
    <description lang="en_GB">Pick a source folder and a destination drive. Shows a preview of every move, then moves or copies (with size check) and renames files to Kodi naming.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
</addons>
