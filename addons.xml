<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.akaguyver" name="akaguyver's Kodi add-ons" version="1.0.0" provider-name="akaguyver">
  <extension point="xbmc.addon.repository" name="akaguyver's Kodi add-ons">
    <dir>
      <info compressed="false">https://akaguyver.github.io/kodi-repo/addons.xml</info>
      <checksum>https://akaguyver.github.io/kodi-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://akaguyver.github.io/kodi-repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Installs and auto-updates Kodi Sorter</summary>
    <description lang="en_GB">Repository for akaguyver's add-ons, served from GitHub Pages.</description>
    <platform>all</platform>
  </extension>
</addon>
<addon id="script.kodisorter" name="Sortovia" version="1.50.0" provider-name="akaguyver">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="context.py">
        <label>32090</label>
        <visible>String.IsEqual(ListItem.DBTYPE,artist)</visible>
      </item>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Sort and rename downloads into the folders Kodi understands. Formerly Kodi Sorter.</summary>
    <description lang="en_GB">Turns a pile of downloads into tidy TV, Movies, Comics and Tutorials folders that Kodi's library can read. You pick a source and a destination, see every move first, and nothing moves until you say so. You can also import files from your phone over Wi-Fi, but you don't need one.</description>
    <disclaimer lang="en_GB">Sortovia moves and deletes files when you approve it. Keep a backup of anything you can't replace. Not affiliated with Kodi or the XBMC Foundation.</disclaimer>
    <platform>all</platform>
    <license>MIT</license>
    <website>https://akaguyver.github.io/kodi-repo/</website>
    <source>https://github.com/sortovia/sortovia</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>resources/media/fanart.png</fanart>
    </assets>
  </extension>
</addon>
</addons>
